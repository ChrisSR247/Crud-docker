# Copia este archivo como .env y cambia los valores.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
# NUNCA subas el archivo .env al repositorio.

# Credenciales de PostgreSQL (se aplican al crear el volumen por primera vez)
POSTGRES_USER=usuario_ejemplo
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=tareas_db

# Puerto del equipo (host) donde se publica la API
API_PORT=3000

# Puerto del equipo (host) donde se publica PostgreSQL
# Cambialo (por ejemplo a 5433) si ya tienes PostgreSQL instalado en Windows
DB_HOST_PORT=5432
